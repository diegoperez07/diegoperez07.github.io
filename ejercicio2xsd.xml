<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:schema id="alumnosSchema" targetNamespace="http://tempuri.org/alumnos" xmlns="http://tempuri.org/alumnos" xmlns_mstns="http://tempuri.org/alumnos" elementFormDefault="qualified">

    <xs:element name="alumnos">
      <xs:complexType>
        <xs:sequence>
          <xs:element name="alumno" maxOccurs="unbounded" type="tipoAlumno"/>
        </xs:sequence>
      </xs:complexType>
    </xs:element>

    <xs:complexType name="tipoAlumno">
      <xs:sequence>
        <xs:element name="nombre" type="xs:string"/>
        <xs:element name="apellidos" type="xs:string"/>
        <xs:element name="domicilio" type="xs:string"/>
        <xs:element name="telefono" maxOccurs="unbounded" type="tipoTelefono"/>
        <xs:element name="equipo" minOccurs="0" type="xs:string"/>
        <xs:element name="aficion" minOccurs="0" maxOccurs="unbounded" type="xs:string"/>
        <xs:element name="origen" type="tipoOrigen"/>
        <xs:element name="comentario" minOccurs="0" type="tipoComentario"/>
        <xs:element name="notas" maxOccurs="unbounded" type="tipoNotas"/>
      </xs:sequence>
      <xs:attribute name="num_alumno" type="xs:ID" use="required"/>
      <xs:attribute name="altura_cm" type="xs:positiveInteger" use="optional"/>
      <xs:attribute name="sexo" type="tipoSexo" use="optional"/>
      <xs:attribute name="ayudado_por" type="xs:IDREF" use="optional"/>
    </xs:complexType>

    <xs:complexType name="tipoTelefono">
      <xs:simpleContent>
        <xs:extension base="xs:string">
          <xs:attribute name="tipo" use="required">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:enumeration value="propio"/>
                <xs:enumeration value="padre"/>
                <xs:enumeration value="madre"/>
                <xs:enumeration value="tutor"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:attribute>
        </xs:extension>
      </xs:simpleContent>
    </xs:complexType>

    <xs:complexType name="tipoOrigen">
      <xs:choice>
        <xs:element name="provincia" type="xs:string"/>
        <xs:element name="pais" type="xs:string"/>
      </xs:choice>
    </xs:complexType>

    <xs:complexType name="tipoComentario" mixed="true">
      <xs:sequence minOccurs="0" maxOccurs="unbounded">
        <xs:any processContents="lax"/>
      </xs:sequence>
    </xs:complexType>

    <xs:complexType name="tipoNotas">
      <xs:sequence>
        <xs:element name="evaluacion" type="xs:string"/>
        <xs:element name="calificacion" type="tipoCalificacion"/>
      </xs:sequence>
    </xs:complexType>

    <xs:simpleType name="tipoSexo">
      <xs:restriction base="xs:string">
        <xs:enumeration value="hombre"/>
        <xs:enumeration value="mujer"/>
      </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="tipoCalificacion">
      <xs:restriction base="xs:decimal">
        <xs:minInclusive value="0"/>
        <xs:maxInclusive value="10"/>
      </xs:restriction>
    </xs:simpleType>

  </xs:schema>

  <alumnos xmlns="http://tempuri.org/alumnos">

