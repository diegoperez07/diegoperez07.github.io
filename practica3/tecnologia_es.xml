    <wording>¿Qué símbolo se usa en CSS para seleccionar un elemento por su ID?</wording>
    <choices>
      <choice>.</choice>
      <choice correct="yes">#</choice>
      <choice>*</choice>
      <choice>@</choice>
    </choices>
  </question>
  <question id="16">
    <wording>¿Cuál es el formato estándar para enviar datos estructurados mediante texto ligero?</wording>
    <choices>
      <choice>TXT</choice>
      <choice>XML</choice>
      <choice correct="yes">JSON</choice>
      <choice>CSV</choice>
    </choices>
  </question>
  <question id="17">
    <wording>¿Qué etiqueta HTML se utiliza para enlazar un archivo JavaScript?</wording>
    <choices>
      <choice>&lt;link&gt;</choice>
      <choice correct="yes">&lt;script&gt;</choice>
      <choice>&lt;js&gt;</choice>
      <choice>&lt;code&gt;</choice>
    </choices>
  </question>
  <question id="18">
    <wording>¿Qué tipo de nodo del DOM representa el texto dentro de una etiqueta XML?</wording>
    <choices>
      <choice>Element node</choice>
      <choice>Attribute node</choice>
      <choice correct="yes">Text node</choice>
      <choice>Comment node</choice>
    </choices>
  </question>
  <question id="19">
    <wording>¿Cuál es el puerto por defecto para el protocolo seguro HTTPS?</wording>
    <choices>
      <choice>80</choice>
      <choice>21</choice>
      <choice correct="yes">443</choice>
      <choice>8080</choice>
    </choices>
  </question>
  <question id="20">
    <wording>¿Qué significa que un documento XML sea "válido"?</wording>
    <choices>
      <choice>Que abre bien en el navegador</choice>
      <choice>Que tiene mayúsculas correctas</choice>
      <choice correct="yes">Que cumple con las reglas de su DTD o Schema</choice>
      <choice>Que pesa menos de 1MB</choice>
    </choices>
  </question>
</test>