]>
<test>
  <question id="1">
    <wording>¿Qué significa XML?</wording>
    <choices>
      <choice correct="yes">eXtensible Markup Language</choice>
      <choice>Excellent Markup Link</choice>
      <choice>Extended Modern Language</choice>
      <choice>eXtra Modern Linux</choice>
    </choices>
  </question>
  <question id="2">
    <wording>¿Qué lenguaje se usa para dar estilo a una página web?</wording>
    <choices>
      <choice>HTML</choice>
      <choice>XML</choice>
      <choice correct="yes">CSS</choice>
      <choice>SQL</choice>
    </choices>
  </question>
  <question id="3">
    <wording>¿Cuál es la función principal de un archivo DTD?</wording>
    <choices>
      <choice>Dar diseño visual al XML</choice>
      <choice correct="yes">Definir la estructura y reglas de un XML</choice>
      <choice>Conectar a una base de datos</choice>
      <choice>Ejecutar código en el servidor</choice>
    </choices>
  </question>
  <question id="4">
    <wording>¿Qué protocolo se utiliza para transferir datos en la web?</wording>
    <choices>
      <choice correct="yes">HTTP / HTTPS</choice>
      <choice>FTP</choice>
      <choice>SSH</choice>
      <choice>SMTP</choice>
    </choices>
  </question>
  <question id="5">
    <wording>¿Cuál de estos elementos es un lenguaje de programación?</wording>
    <choices>
      <choice>HTML</choice>
      <choice>CSS</choice>
      <choice>XML</choice>
      <choice correct="yes">JavaScript</choice>
    </choices>
  </question>
  <question id="6">
    <wording>¿Qué etiqueta se usa en HTML para insertar un salto de línea?</wording>
    <choices>
      <choice correct="yes">&lt;br&gt;</choice>
      <choice>&lt;lb&gt;</choice>
      <choice>&lt;break&gt;</choice>
      <choice>&lt;p&gt;</choice>
    </choices>
  </question>
  <question id="7">
    <wording>En XML, ¿las etiquetas distinguen entre mayúsculas y minúsculas?</wording>
    <choices>
      <choice correct="yes">Sí, siempre</choice>
      <choice>No, nunca</choice>
      <choice>Solo en las etiquetas raíz</choice>
      <choice>Depende del navegador</choice>
    </choices>
  </question>
  <question id="8">
    <wording>¿Qué significa AJAX?</wording>
    <choices>
      <choice>Advanced JavaScript and XML</choice>
      <choice correct="yes">Asynchronous JavaScript and XML</choice>
      <choice>Automated JSON and XHTML</choice>
      <choice>Asynchronous JSON and XML</choice>
    </choices>
  </question>
  <question id="9">
    <wording>¿Qué objeto nativo de JavaScript se utiliza para realizar peticiones AJAX?</wording>
    <choices>
      <choice>JSONRequest</choice>
      <choice>FetchObject</choice>
      <choice correct="yes">XMLHttpRequest</choice>
      <choice>HttpHandler</choice>
    </choices>
  </question>
  <question id="10">
    <wording>¿Cuál es la versión actual del estándar HTML dominante?</wording>
    <choices>
      <choice>HTML4</choice>
      <choice>XHTML</choice>
      <choice correct="yes">HTML5</choice>
      <choice>HTML6</choice>
    </choices>
  </question>
  <question id="11">
    <wording>¿Qué propiedad CSS cambia el color de fondo?</wording>
    <choices>
      <choice>color</choice>
      <choice correct="yes">background-color</choice>
      <choice>bgcolor</choice>
      <choice>mask-color</choice>
    </choices>
  </question>
  <question id="12">
    <wording>¿Cómo se cierra correctamente un elemento XML vacío?</wording>
    <choices>
      <choice>&lt;elemento&gt;</choice>
      <choice>&lt;/elemento&gt;</choice>
      <choice correct="yes">&lt;elemento /&gt;</choice>
      <choice>&lt;\elemento&gt;</choice>
    </choices>
  </question>
  <question id="13">
    <wording>¿Qué contenedor web permite almacenar datos de sesión localmente de forma persistente?</wording>
    <choices>
      <choice correct="yes">localStorage</choice>
      <choice>sessionCookie</choice>
      <choice>XMLStore</choice>
      <choice>DataCache</choice>
    </choices>
  </question>
  <question id="14">
    <wording>¿Qué significa DOM en desarrollo web?</wording>
    <choices>
      <choice>Data Object Model</choice>
      <choice correct="yes">Document Object Model</choice>
      <choice>Digital Output Media</choice>
      <choice>Direct Object Management</choice>
    </choices>
  </question>
